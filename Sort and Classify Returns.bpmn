                <triso:system name="WMS" triso:readOnly="false" id="_aaf81dd7-6d0c-49fc-88c5-fa889bc388e8"/>
                <triso:goal name="Maintain high inventory accuracy to prevent stockouts or excess inventory caused by discrepancies" triso:readOnly="false" id="_0adf8100-5fb6-4186-9d0a-b147bf102bd5"/>
                <triso:goal name="Accurately log and review inspection results to ensure the correct classification of items." triso:readOnly="false" id="_bd58226c-d960-48be-9ab7-6b0147687448"/>
                <triso:goal name="Correctly determine the appropriate action for each item based on its condition, ensuring alignment with company policies and value recovery strategies." triso:readOnly="false" id="_50aef810-8f1f-415b-87a4-6cf068ed2b61"/>
                <triso:goal name="Physically organize items into the correct categories (resellable, refurbish, recycle, dispose) to streamline downstream processes and reduce handling time." triso:readOnly="false" id="_86670e43-9d88-41e6-a972-459a23ac8a94"/>
                <triso:goal name="Quickly return resellable items to inventory, minimizing the time they spend off the shelf and maximizing potential sales opportunities." triso:readOnly="false" id="_1e14d7dc-019b-466a-946f-a20327a03b49"/>
                <triso:goal name="Efficiently route items to refurbishment, ensuring that they are repaired and prepared for resale in a timely manner." triso:readOnly="false" id="_5324986e-01f3-458f-a727-77acb57d2174"/>
                <triso:goal name="Ensure that items are recycled or disposed of responsibly and in compliance with environmental regulations, minimizing the environmental impact and potential legal risks." triso:readOnly="false" id="_f0b7c455-9c7c-4ba5-a082-364c04da630a"/>
                <triso:goal name="Accurately determine the appropriate action for each item based on its condition, ensuring compliance with company policies and maximizing value recovery strategies." triso:readOnly="false" id="_e2d6f209-d18b-45e9-b765-b4869b3a15a1"/>
            </triso:graphObjects>
