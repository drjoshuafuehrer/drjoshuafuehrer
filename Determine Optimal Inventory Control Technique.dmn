    <semantic:inputData id="_a0285c47-1624-45de-b548-6448d9d44484" name="Inventory" triso:readOnly="false">
        <semantic:description>&lt;p&gt;Inventory represents the stock of products available in the warehouse. It includes attributes such as a unique identifier (InventoryID), warehouse ID, product ID, quantity, and reorder level. Inventory management ensures that the right amount of product is available to meet demand without overstocking.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_6666bf71-653b-4c53-82e3-5acd74b1edee" modelName="Logistics Management Entity Model" itemName="Inventory" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b255f6ab-4b5d-42b8-aafb-c72da914ebe5" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Inventory" id="_89f0ae6f-9a01-4a7e-81d5-3ceda5d63c59" typeRef="InventoryData"/>
    </semantic:inputData>
    <semantic:inputData id="_2daaee0c-c278-44b5-a376-fab30cce12ac" name="Supplier" triso:readOnly="false">
        <semantic:description>&lt;p&gt;A Supplier is an external entity that provides products to the warehouse. Suppliers have attributes such as a unique identifier (SupplierID), name, contact information, and address. They are essential for maintaining the inventory levels by supplying necessary goods. It also contains information on lead times and delivery performance.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_ee92e337-6b71-4a52-b006-f5568c04df8e" modelName="Logistics Management Entity Model" itemName="Supplier" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_3483c4a4-f4ce-4ef7-8fd0-586a90cbb734" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Supplier" id="_289fb17c-649b-49ca-9fb3-36cbb42d02c4" typeRef="Supplier"/>
    </semantic:inputData>
