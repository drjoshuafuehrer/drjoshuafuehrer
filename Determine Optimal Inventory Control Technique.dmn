    <semantic:inputData id="_e5386c1d-46e1-45f7-949e-d6a1a84ddcb4" name="Cost Data" triso:readOnly="false">
        <semantic:description>&lt;p&gt;Data on holding costs, ordering costs, and shortage costs.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_d08f9e8b-6bef-4dfe-bf55-f7c8c3b2f485" modelName="Logistics Management Entity Model" itemName="Cost Data" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_72163f93-a095-4b6d-90fb-253d1a307d71" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
