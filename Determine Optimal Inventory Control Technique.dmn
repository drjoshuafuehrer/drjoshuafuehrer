    <semantic:itemDefinition name="Demand" label="Demand" isCollection="false">
        <semantic:extensionElements>
            <triso:reuseLink id="_0a8f634a-09df-4116-8920-3070f9fd91cc" modelName="Logistics Management Entity Model" itemName="Demand" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#Demand" graphType="http://www.trisotech.com/graph/1.0/element#ItemDefinition" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:itemComponent id="_1f8cea20-1bd0-40f0-9815-a8d09ce36d96" name="HistoricalDemand" isCollection="false">
            <semantic:typeRef>number</semantic:typeRef>
            <semantic:allowedValues>
                <semantic:extensionElements>
                    <triso:constraintDetails id="_8aa52a5c-1d3d-4a4d-b3d0-00939a30e41b" constraintsType="expression">
                        <triso:value>&gt;"list"&lt;"number"</triso:value>
                        <triso:display>&gt;"list"&lt;"number"</triso:display>
                    </triso:constraintDetails>
                </semantic:extensionElements>
                <semantic:text>&gt;"list"&lt;"number"</semantic:text>
            </semantic:allowedValues>
        </semantic:itemComponent>
        <semantic:itemComponent id="_ff4e01fb-95e2-4eb3-89e9-0cfdbe546bad" name="AverageDemand" isCollection="false">
            <semantic:typeRef>number</semantic:typeRef>
            <semantic:allowedValues>
                <semantic:extensionElements>
                    <triso:constraintDetails id="_63276e42-d338-4346-887a-e0676364d9ab" constraintsType="expression">
                        <triso:value>sum("Historical Demand") / count("Historical Demand")</triso:value>
                        <triso:display>sum("Historical Demand") / count("Historical Demand")</triso:display>
                    </triso:constraintDetails>
                </semantic:extensionElements>
                <semantic:text>sum("Historical Demand") / count("Historical Demand")</semantic:text>
            </semantic:allowedValues>
        </semantic:itemComponent>
        <semantic:itemComponent id="_bd0bbedb-689d-4410-b450-4994ce5073de" name="DemandStandardDeviation" isCollection="false">
            <semantic:typeRef>number</semantic:typeRef>
            <semantic:allowedValues>
                <semantic:extensionElements>
                    <triso:constraintDetails id="_817e20e1-2d1e-4bc8-8392-eedcc625b36a" constraintsType="expression">
                        <triso:value>sqrt(sum(for d in "Historical Demand" return (d - "Average Demand") ** 2) / count("Historical Demand"))</triso:value>
                        <triso:display>sqrt(sum(for d in "Historical Demand" return (d - "Average Demand") ** 2) / count("Historical Demand"))</triso:display>
                    </triso:constraintDetails>
                </semantic:extensionElements>
                <semantic:text>sqrt(sum(for d in "Historical Demand" return (d - "Average Demand") ** 2) / count("Historical Demand"))</semantic:text>
            </semantic:allowedValues>
        </semantic:itemComponent>
        <semantic:itemComponent id="_a174845f-0b8f-47fb-90d9-e34a1e5f7cf0" name="DemandVariability" isCollection="false">
            <semantic:typeRef>number</semantic:typeRef>
            <semantic:allowedValues>
                <semantic:extensionElements>
                    <triso:constraintDetails id="_74da7b25-b42b-4250-9665-91da58b59a2d" constraintsType="expression">
                        <triso:value>"Demand Standard Deviation" / "Average Demand"</triso:value>
                        <triso:display>"Demand Standard Deviation" / "Average Demand"</triso:display>
                    </triso:constraintDetails>
                </semantic:extensionElements>
                <semantic:text>"Demand Standard Deviation" / "Average Demand"</semantic:text>
            </semantic:allowedValues>
        </semantic:itemComponent>
    </semantic:itemDefinition>
