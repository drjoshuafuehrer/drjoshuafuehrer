        <semantic:description>&lt;p&gt;Projected demand data.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_dfc576be-d6b6-4157-bb46-9d78485c94b8" modelName="Logistics Management Entity Model" itemName="Demand Forecast" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_2dadcc89-1862-4e10-bce7-df3006de9b6b" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
