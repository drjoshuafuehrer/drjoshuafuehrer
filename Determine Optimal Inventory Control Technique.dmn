    <semantic:decision id="_f70a2573-2964-4c7d-ab79-ee652d65dd68" name="Assess Inventory Turnover" triso:readOnly="false">
        <semantic:description>&lt;p&gt;&lt;strong&gt;Assess Inventory Turnover&lt;/strong&gt;: This decision evaluates how frequently inventory is sold and replaced over a given period.&lt;/p&gt;</semantic:description>
        <semantic:variable name="Assess Inventory Turnover" id="_0f61259c-0fff-4793-a578-5a0778d4c52d" typeRef="Inventory_Turnover_Rating"/>
        <semantic:informationRequirement id="_a559c3f5-1988-4e2f-b605-4743ca5ab0e3" triso:readOnly="false">
            <semantic:requiredInput href="#_a0285c47-1624-45de-b548-6448d9d44484"/>
        </semantic:informationRequirement>
        <semantic:literalExpression id="_3af151d1-e9c8-4301-a7db-a4f9309e074c" triso:unparsed="false" triso:descriptionVisible="false" typeRef="Inventory_Turnover_Rating" triso:expressionId="_e3f3b003-d27b-4d26-b408-b6d3a59ec158">
            <semantic:text>"Inventory Turnover" = "Sales" / "Average Inventory"</semantic:text>
        </semantic:literalExpression>
    </semantic:decision>
    <semantic:decision id="_1ec5730d-3b20-41ff-8a78-5ab31f11c488" name="Evaluate Demand Variability" triso:readOnly="false">
        <semantic:description>&lt;p&gt;&lt;strong&gt;Evaluate Demand Variability&lt;/strong&gt;: This decision assesses how much demand fluctuates over time.&lt;/p&gt;</semantic:description>
        <semantic:variable name="Evaluate Demand Variability" id="_a25e040f-00d0-4531-a25a-6a132a3677ad" typeRef="tEvaluateDemandVariability"/>
        <semantic:informationRequirement id="_43751a6a-0434-4cc4-a1c4-fcf403041d23" triso:readOnly="false">
            <semantic:requiredInput href="#_d559870e-10a8-4af0-8b26-64feb788fabb"/>
        </semantic:informationRequirement>
        <semantic:literalExpression id="_c2fcb398-85db-4c81-be34-2496fabf1c21" triso:descriptionVisible="false" typeRef="tEvaluateDemandVariability" triso:expressionId="_353be651-ae22-4ab4-9926-3fc2da9020ca">
            <semantic:text>"Demand Variability" = "Demand Standard Deviation" / "Average Demand"</semantic:text>
        </semantic:literalExpression>
    </semantic:decision>
    <semantic:decision id="_6a0fb87d-8343-48f7-88a2-dad68fbdeaa8" name="Analyze Holding Costs" triso:readOnly="false">
        <semantic:description>&lt;p&gt;&lt;strong&gt;Analyze Holding Costs&lt;/strong&gt;: This decision considers the costs of storing inventory, including warehousing, insurance, and obsolescence.&lt;/p&gt;</semantic:description>
        <semantic:variable name="Analyze Holding Costs" id="_ecbb3841-c52d-48f4-adea-e2cde46f79b3" typeRef="tAnalyzeHoldingCosts"/>
        <semantic:informationRequirement id="_6f4ca148-433e-46d9-83f4-291274859288" triso:readOnly="false">
            <semantic:requiredInput href="#_e5386c1d-46e1-45f7-949e-d6a1a84ddcb4"/>
        </semantic:informationRequirement>
        <semantic:literalExpression id="_f826bc05-d030-4913-b819-41a0dbc78202" triso:descriptionVisible="false" typeRef="tAnalyzeHoldingCosts" triso:expressionId="_5a3735b7-671e-477c-9428-d150f63d531d">
            <semantic:text>"Holding Costs" = ("Average Inventory" * "Cost per Unit") + "Warehouse Costs"</semantic:text>
        </semantic:literalExpression>
    </semantic:decision>
    <semantic:decision id="_7260a460-d335-4279-97b2-bcc153ece263" name="Check Supplier Reliability" triso:readOnly="false">
        <semantic:description>&lt;p&gt;&lt;strong&gt;Check Supplier Reliability&lt;/strong&gt;: This decision examines the consistency and reliability of suppliers in terms of lead times and delivery performance.&lt;/p&gt;</semantic:description>
        <semantic:variable name="Check Supplier Reliability" id="_9d8defa5-ead7-4577-8291-cfb8234d68e9" typeRef="tCheckSupplierReliability"/>
        <semantic:informationRequirement id="_43309856-7a90-404d-9731-a2495f836126" triso:readOnly="false">
            <semantic:requiredInput href="#_2daaee0c-c278-44b5-a376-fab30cce12ac"/>
        </semantic:informationRequirement>
        <semantic:literalExpression id="_0aa751e1-46aa-4819-abdf-987f52b74c87" triso:descriptionVisible="false" typeRef="tCheckSupplierReliability" triso:expressionId="_c73a477d-36b0-422c-8a79-5f942e7ce5ec">
            <semantic:text>"SupplierReliability" = ("Number of On-time Deliveries" / "Total Deliveries") * 100</semantic:text>
        </semantic:literalExpression>
    </semantic:decision>
