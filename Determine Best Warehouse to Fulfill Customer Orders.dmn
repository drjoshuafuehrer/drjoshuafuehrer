    <semantic:inputData id="_ba401fe6-b30d-40ed-ba55-ca49e8830f4f" name="Order" triso:readOnly="false">
        <semantic:description>&lt;p&gt;An Order is a request for products made by a customer. Each order has attributes like a unique identifier (Order ID), order date, customer name, and total amount. Orders detail the products requested by customers and are essential for tracking sales and fulfillment.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_7950d3dc-5240-4a1b-938b-3de611952354" modelName="Logistics Management Entity Model" itemName="Order" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b54bbf53-9337-48b7-a572-67b15d181b59" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Order" id="_9d4c12a2-6169-49af-aaf7-3edecc3fd71f" typeRef="Order"/>
    </semantic:inputData>
    <semantic:inputData id="_93bbced3-b71b-4e9b-921f-ec06ba7138cd" name="Inventory" triso:readOnly="false">
        <semantic:description>&lt;p&gt;Inventory represents the stock of products available in the warehouse. It includes attributes such as a unique identifier (InventoryID), warehouse ID, product ID, quantity, and reorder level. Inventory management ensures that the right amount of product is available to meet demand without overstocking.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_323fe75e-fa98-4deb-b2a0-7ca3708287e1" modelName="Logistics Management Entity Model" itemName="Inventory" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b255f6ab-4b5d-42b8-aafb-c72da914ebe5" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Inventory" id="_acf9bd74-69fe-4672-808d-3cabedd7983a" typeRef="InventoryData"/>
    </semantic:inputData>
    <semantic:inputData id="_58604e7f-f9af-41a2-a958-a338c8d39485" name="Location" triso:readOnly="false">
        <semantic:description>&lt;p&gt;The &lt;strong&gt;Location&lt;/strong&gt; entity represents the geographical and physical address information associated with various components of the Warehouse Management System, such as warehouses, employees, and orders. This entity is crucial for identifying and managing the physical places where activities occur, ensuring that logistics and operations are well-coordinated.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_df7222d8-ecd8-4528-9128-4555cdd1a104" modelName="Logistics Management Entity Model" itemName="Location" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_40f37cae-ac38-4240-9803-64bdb9295fc4" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Location" id="_94058f52-2ea5-4b14-b17b-6c9c08e2c617" typeRef="Location"/>
    </semantic:inputData>
    <semantic:inputData id="_eb762fa9-ca54-43bc-8329-e59b4dad4f72" name="Shipping Rate" triso:readOnly="false">
        <semantic:description>&lt;p&gt;The &lt;strong&gt;Shipping Rate&lt;/strong&gt; represents the cost structure of shipping products from the warehouse to customers. This entity is crucial for calculating the total cost of shipping based on factors such as weight, distance, and the carrier used. Shipping rates can vary depending on the carrier and specific pricing models, and they are often updated periodically to reflect changes in transportation costs.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_c5217560-d5de-4f5a-88a8-0bf0f8297957" modelName="Logistics Management Entity Model" itemName="Shipping Rate" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_806c9c11-4180-4b2a-b930-ce7397ee6eed" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Shipping Rate" id="_d91f8664-e7a0-4c70-b3c9-d849451eee84" typeRef="ShippingRate"/>
    </semantic:inputData>
