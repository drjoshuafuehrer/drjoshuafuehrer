    <bpmndi:BPMNDiagram id="_0b6d1d91-4f1b-400c-a97f-3b7631106d29" name="Transport Disposal">
        <bpmndi:BPMNPlane bpmnElement="_c24f3d49-adf5-432d-b724-14694ce158e2" id="_0b6d1d91-4f1b-400c-a97f-3b7631106d29_plane" trisobpmn:diagramWidth="1485" trisobpmn:diagramHeight="1050"/>
    </bpmndi:BPMNDiagram>
    <semantic:relationship type="trisoExtension">
        <semantic:extensionElements>
            <triso:graphObjects>
                <triso:system name="Return Management System" triso:readOnly="false" id="_ed4bd46d-9377-4278-b818-cd5672c5d0c4"/>
                <triso:system name="Environmental Compliance System" triso:readOnly="false" id="_f78db5cf-4241-4197-b54c-4cfa1c7366c1"/>
                <triso:system name="Email" triso:readOnly="false" id="_99806bbb-21ed-498f-b1aa-124d17b3a19d"/>
                <triso:system name="IMS" triso:readOnly="false" id="_93620dfd-a3e7-47f1-b7c1-a5db893476f1"/>
                <triso:goal name="Accurately log and track the receipt of items designated for disposal to ensure they are handled correctly and routed to the appropriate disposal process without delay." triso:readOnly="false" id="_08f8a97b-b8ac-49e5-878e-78e9a55f1e90"/>
                <triso:goal name="Validate that the item is indeed non-repairable and non-recyclable before proceeding with disposal, minimizing the risk of unnecessary waste and ensuring responsible decision-making." triso:readOnly="false" id="_533383d1-7890-4bd9-a262-3fee63eadf68"/>
                <triso:goal name="Select the most appropriate and environmentally responsible disposal method (e.g., landfill, incineration, hazardous waste) based on the item’s material composition and relevant regulations." triso:readOnly="false" id="_f579f1dd-6e41-4b00-80cf-70fd857e7896"/>
                <triso:goal name="Efficiently and accurately sort items into the correct disposal categories, reducing handling errors and ensuring that items are disposed of in the correct manner." triso:readOnly="false" id="_6d5af76a-8b28-4efc-89a1-f76872d9fe90"/>
                <triso:goal name="Effectively communicate and coordinate with disposal partners to ensure timely and compliant disposal of items, minimizing storage time and associated costs." triso:readOnly="false" id="_1914ba10-a915-410b-ac32-5a1db8cd59d1"/>
                <triso:goal name="Maintain accurate records of items removed from inventory for disposal and document the disposal process for compliance and reporting purposes, ensuring transparency and traceability." triso:readOnly="false" id="_0708584d-33f7-420e-88dc-797eac51767d"/>
                <triso:goal name="Accurately document the disposal process for compliance and reporting purposes, ensuring transparency and traceability." triso:readOnly="false" id="_c4727bcf-5dfd-42cc-9983-c7582398ce81"/>
                <triso:goal name="Create detailed reports that summarize the disposal process, including quantities, disposal methods, and compliance with regulations, to support internal reviews and fulfill regulatory requirements." triso:readOnly="false" id="_1a8cb03b-1075-4ecd-93d3-fc00b46fb60a"/>
                <triso:goal name="Ensure that all relevant data is recorded, the disposal case is officially closed, and records are archived for future reference, enabling thorough audits and reviews as needed." triso:readOnly="false" id="_97997c1c-67f9-4aad-983f-24e592af30ea"/>
