        <semantic:textAnnotation id="_6693f934-8686-4e18-ba98-ef48f8fc8f02">
            <semantic:text>It’s a copy of the bill of lading. First we get verbal confirmation then we ask for the bol/pod. Without that paperwork, the carrier can’t get paid.</semantic:text>
        </semantic:textAnnotation>
        <semantic:textAnnotation id="_420eb357-8735-4fa2-b975-9eac9fc3fa33">
            <semantic:text>Includes Pickup, Origin, DH-O, Destination, DH-D, TRIP, EQ, LEN, Weight, F/P, Factor, CS, DTP, Company, Contact, and Offer</semantic:text>
        </semantic:textAnnotation>
        <semantic:association id="_05f0cafd-d593-4890-accb-60ab47fe003e" triso:readOnly="false" sourceRef="_05f507c9-e6ec-4440-acc5-8e3f778fdd00" targetRef="_420eb357-8735-4fa2-b975-9eac9fc3fa33" associationDirection="None"/>
    </semantic:process>
