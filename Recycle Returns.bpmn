    <semantic:relationship type="trisoExtension">
        <semantic:extensionElements>
            <triso:graphObjects>
                <triso:system name="Return Management System" triso:readOnly="false" id="_6d4be0bd-13a1-441e-a84b-89f759106d7a"/>
                <triso:system name="E-mail" triso:readOnly="false" id="_0d2d73f1-62be-43dc-8b78-611474360cc4"/>
                <triso:system name="Phone" triso:readOnly="false" id="_22104cad-662c-4f00-8269-dbed5cd4dba8"/>
                <triso:system name="IMS" triso:readOnly="false" id="_8a0782bf-3c44-4d13-b669-e0f282610695"/>
                <triso:goal name="Ensure accurate logging of items designated for recycling and confirm that they are properly routed to the recycling process without delay." triso:readOnly="false" id="_d611293b-00b3-421a-96b2-45e6cd49c14b"/>
                <triso:goal name="Efficiently and accurately identify materials within the returned items that can be recycled, maximizing the amount of material that can be diverted from landfill." triso:readOnly="false" id="_942103e7-1fa9-4edd-a361-89c01bf91d88"/>
                <triso:goal name="Effectively communicate with recycling partners to ensure that recyclable materials are transported to the correct facilities in a timely manner, minimizing storage time and handling costs." triso:readOnly="false" id="_3ca1cbda-1232-4582-be81-46455fdc3bfe"/>
                <triso:goal name="Safely and efficiently transport sorted materials to the recycling facility, ensuring that all logistical arrangements are made and that materials arrive in good condition for processing." triso:readOnly="false" id="_9344d50d-9487-4788-97c1-c7641367343a"/>
                <triso:goal name="Plan transportation that is efficient." triso:readOnly="false" id="_6b7ece5f-93a8-4746-a4ed-f16bb285deb0"/>
                <triso:goal name="Accurately update inventory records to reflect the removal of items" triso:readOnly="false" id="_81ce2acd-f0bc-4f89-ac23-fc10f7acce75"/>
                <triso:goal name="Accurate recycling logs for compliance and reporting purposes." triso:readOnly="false" id="_f673f3cd-3768-44fa-a76c-266f7073181f"/>
                <triso:goal name="Produce accurate and comprehensive reports on the recycling process, including quantities of materials recycled, environmental impact, and compliance with regulations, to support internal goals and external reporting requirements." triso:readOnly="false" id="_ad11b806-bcc4-4291-9f69-fac955ccbff1"/>
                <triso:goal name="Ensure all relevant data is recorded and archived, and the recycling case is officially closed, allowing for future reference and analysis of recycling performance." triso:readOnly="false" id="_6d27238b-5687-4db7-9c66-812ea48da8c4"/>
            </triso:graphObjects>
        </semantic:extensionElements>
