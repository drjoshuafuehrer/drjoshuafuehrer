            <semantic:dataInputAssociation id="_ee1589a8-d669-45f2-a7e8-6416332e6a36">
                <semantic:sourceRef>_0ffc12c0-6da3-4feb-80d3-4884bea406da</semantic:sourceRef>
                <semantic:targetRef>_d7fb63ff-481c-4f79-9e19-383b0817fb7c</semantic:targetRef>
            </semantic:dataInputAssociation>
            <semantic:performer id="_d90e23ee-3e99-402c-9efc-e6d9eda964b1">
                <semantic:resourceRef>_674358c0-fb02-45b9-9890-75d1b86fb51b</semantic:resourceRef>
            </semantic:performer>
            <semantic:textAnnotation id="_00d8ceb4-5be8-44d4-a7b3-14a839f6440e">
                <semantic:text>Develop a procurement schedule based on reorder points and forecasted demand.
Collaborate with suppliers to align delivery schedules and lead times with inventory requirements.
Negotiate terms and conditions with suppliers to ensure favorable pricing and reliable supply.
Monitor supplier performance and address any issues that may affect inventory availability.</semantic:text>
            </semantic:textAnnotation>
        </semantic:subProcess>
        <semantic:endEvent id="_0d4e7efd-707f-4a5c-90d3-bf9a27d960bb" triso:readOnly="false">
            <semantic:incoming>_763ab8ff-a98b-48f7-bb5a-06373f786e53</semantic:incoming>
        </semantic:endEvent>
        <semantic:dataObject id="_d944d4e0-9561-4979-b2fb-99a9b9e3b61b" name="Forecasting model" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false"/>
        <semantic:dataObject id="_ec056eaf-a0e1-4802-be53-8bdcac9678f5" name="Data characteristics" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false"/>
        <semantic:dataObject id="_a0308799-7a65-4709-a976-cbd21cfd9ac0" name="Forecast data" triso:readOnly="false" itemSubjectRef="_8cafbab5-753b-411a-b44b-3d91e735453f" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Generated forecasts for future demand.&lt;br /&gt;&lt;br /&gt;&lt;/p&gt;</semantic:documentation>
        </semantic:dataObject>
        <semantic:dataObject id="_3fe33f99-c08a-4a11-bc8d-9216ef2ca257" name="Market trend data" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Information on market trends affecting demand.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Market growth rates, economic indicators, competitor actions.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_d3c76a27-d9e7-447f-a73a-3a083ec727a3" name="Historical sales data" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Records of past sales transactions.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Date, product ID, quantity sold, sales price, customer ID.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_a84e3c1f-b0f2-4716-8294-a90e369598a6" name="Inventory Levels" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Current stock levels of products.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Product ID, quantity in stock, reorder point, safety stock level.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_d439a36e-062e-4ca8-ab80-4ff0de062f9a" name="Supplier Information" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Details about suppliers.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Supplier ID, lead time, order quantities, delivery performance.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_c5bcee9f-fece-477d-8ced-7664b510a404" name="Order" triso:readOnly="false" itemSubjectRef="_e5da36f1-c9b8-4ca4-b648-5e1bb4804b33" isCollection="false">
            <semantic:documentation>&lt;p&gt;An Order is a request for products made by a customer. Each order has attributes like a unique identifier (Order ID), order date, customer name, and total amount. Orders detail the products requested by customers and are essential for tracking sales and fulfillment.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:reuseLink id="_c1bf5e89-c490-498a-8462-2ab79ca204cc" modelName="Logistics Management Entity Model" itemName="Order" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b54bbf53-9337-48b7-a572-67b15d181b59" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_cd27789c-79fc-4426-983c-afa32c8c3bb5" name="External Factor Data" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Information on external factors influencing demand.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Economic indicators, weather data, regulatory changes.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:dataObject id="_a4562738-7fc6-4629-a3fc-3279613a4ccc" name="Promotional Activity Information" triso:readOnly="false" itemSubjectRef="_triso-default-bpmnItemDefinition-string_id" isCollection="false">
            <semantic:documentation>&lt;p&gt;Description: Information on marketing and promotional activities.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:notes>&lt;p&gt;Attributes: Promotion ID, product ID, promotion start date, promotion end date, discount rate.&lt;/p&gt;</triso:notes>
            </semantic:extensionElements>
        </semantic:dataObject>
