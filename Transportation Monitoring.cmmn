<semantic:definitions xmlns:semantic="http://www.omg.org/spec/CMMN/20151109/MODEL"  xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI"  xmlns:di="http://www.omg.org/spec/CMMN/20151109/DI"  xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC"  xmlns:trisocmmn="http://www.trisotech.com/2014/triso/cmmn"  xmlns:triso="http://www.trisotech.com/2015/triso/modeling"  xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/"  xmlns:rss="http://purl.org/rss/2.0/"   xmlns:i18n="http://www.omg.org/spec/BPMN/non-normative/extensions/i18n/1.0"  xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/"  xmlns:sdmn="https://www.omg.org/spec/SDMN/"  xmlns:boxedext="https://www.trisotech.com/spec/DMN/20191111/EXT/"  xmlns="http://www.trisotech.com/definitions/_d5671e1d-2588-4024-8a78-bc9ce0e52b8e" id="_d5671e1d-2588-4024-8a78-bc9ce0e52b8e" name="Transportation Monitoring" targetNamespace="http://www.trisotech.com/definitions/_d5671e1d-2588-4024-8a78-bc9ce0e52b8e" expressionLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" exporter="Case Modeler" exporterVersion="9.6.3" xml:lang="en" triso:logoChoice="Default">
    <semantic:caseFileItemDefinition name="Stowage Plan" definitionType="http://www.trisotech.com/2015/triso/modeling/ItemDefinitionType" structureRef="Any" id="_5cfd23ad-769f-42a3-b73c-d5d00137a49f"/>
    <semantic:case id="Case_2702086f-b142-444a-b974-de090e573340" name="Global Transportation Monitoring" triso:collectMilestones="true">
        <semantic:extensionElements/>
        <semantic:caseFileModel>
            <semantic:caseFileItem id="_ba703ec1-cb32-4c0b-94f1-f42a920ff953" name="Stowage Plan" definitionRef="_5cfd23ad-769f-42a3-b73c-d5d00137a49f">
                <semantic:documentation>&lt;p&gt;A &lt;strong&gt;storage plan&lt;/strong&gt; is a layout for cargo transport to optimize the placement and arrangement of items or goods within a storage space.&lt;/p&gt;</semantic:documentation>
                <semantic:extensionElements>
                    <triso:reuseLink id="_1a29195d-768e-4518-b8f7-aaad929f1d83" modelName="Logistics Management Entity Model" itemName="Stowage Plan" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_220558fe-d4b9-4ade-b2f1-77488d928a5c" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
                    <triso:notes>&lt;p&gt;The primary objectives of a stowage plan are to:&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;Maximize Space Utilization&lt;/strong&gt;: Efficiently use available storage space to accommodate as many items as possible.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Ensure Safe Handling&lt;/strong&gt;: Arrange items in a way that prevents damage during storage or transport.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Facilitate Easy Access&lt;/strong&gt;: Organize goods for quick retrieval, reducing the time needed for loading, unloading.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Maintain Balance and Stability&lt;/strong&gt;: In the case of transport, ensure that the load is evenly distributed to maintain stability and safety.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Comply with Regulations&lt;/strong&gt;: Adhere to legal or industry-specific guidelines, such as weight limits or hazardous material handling protocols.&lt;/li&gt;
&lt;/ol&gt;</triso:notes>
                </semantic:extensionElements>
            </semantic:caseFileItem>
        </semantic:caseFileModel>
