    <semantic:caseFileItemDefinition name="Order" definitionType="http://www.trisotech.com/2015/triso/modeling/ItemDefinitionType" structureRef="Order" id="_095b530e-ed01-4a8f-b1c8-dc7886d1d0fe"/>
    <semantic:caseFileItemDefinition name="Customer Issue" id="_a53b5a8d-e726-4502-8098-6979e6c3baf1"/>
    <semantic:caseFileItemDefinition name="Inventory" definitionType="http://www.trisotech.com/2015/triso/modeling/ItemDefinitionType" structureRef="InventoryData" id="_59bc1e60-cf6c-4a2b-a41c-18a13afb520c"/>
    <semantic:case id="Case_fc2ad798-8397-498e-81c2-5ab3165041ea" name="Process Order" triso:collectMilestones="true">
        <semantic:extensionElements/>
        <semantic:caseFileModel>
            <semantic:caseFileItem id="_f608b16e-3bf8-4174-87ef-7fd07ea5fc91" name="Order" definitionRef="_095b530e-ed01-4a8f-b1c8-dc7886d1d0fe">
                <semantic:documentation>&lt;p&gt;An Order is a request for products made by a customer. Each order has attributes like a unique identifier (Order ID), order date, customer name, and total amount. Orders detail the products requested by customers and are essential for tracking sales and fulfillment.&lt;/p&gt;</semantic:documentation>
                <semantic:extensionElements>
                    <triso:reuseLink id="_eb8099fc-29f3-4724-aa2c-cd49011a41a6" modelName="Logistics Management Entity Model" itemName="Order" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b54bbf53-9337-48b7-a572-67b15d181b59" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
                </semantic:extensionElements>
            </semantic:caseFileItem>
            <semantic:caseFileItem id="_9e6787d6-dc79-4430-9541-b360283d904f" name="Inventory" definitionRef="_59bc1e60-cf6c-4a2b-a41c-18a13afb520c">
                <semantic:documentation>&lt;p&gt;Inventory represents the stock of products available in the warehouse. It includes attributes such as a unique identifier (InventoryID), warehouse ID, product ID, quantity, and reorder level. Inventory management ensures that the right amount of product is available to meet demand without overstocking.&lt;/p&gt;</semantic:documentation>
                <semantic:extensionElements>
                    <triso:reuseLink id="_17aeb79b-5d6f-4873-997b-ba3130e3e5e1" modelName="Logistics Management Entity Model" itemName="Inventory" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b255f6ab-4b5d-42b8-aafb-c72da914ebe5" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
                </semantic:extensionElements>
            </semantic:caseFileItem>
            <semantic:caseFileItem id="_5e39d58c-d0d8-4a31-bcc1-7bc5b566a667" name="Loading Incident Report" definitionRef="_52141fa4-31d6-47f9-8fdb-1284117ef32d"/>
            <semantic:caseFileItem id="_73812e7e-e3a9-4c9f-bf8e-af82731fc46e" name="Accident Report" definitionRef="_1eef71f6-d2ca-4ace-b162-707c6f3d8ca8"/>
            <semantic:caseFileItem id="_b4ac2780-dc43-45a8-9538-f4f5962bdf1e" name="Order" definitionRef="_095b530e-ed01-4a8f-b1c8-dc7886d1d0fe">
                <semantic:documentation>&lt;p&gt;An Order is a request for products made by a customer. Each order has attributes like a unique identifier (Order ID), order date, customer name, and total amount. Orders detail the products requested by customers and are essential for tracking sales and fulfillment.&lt;/p&gt;</semantic:documentation>
                <semantic:extensionElements>
                    <triso:reuseLink id="_eb8099fc-29f3-4724-aa2c-cd49011a41a6" modelName="Logistics Management Entity Model" itemName="Order" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_b54bbf53-9337-48b7-a572-67b15d181b59" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
                </semantic:extensionElements>
            </semantic:caseFileItem>
        </semantic:caseFileModel>
