    <semantic:decision id="_c9ced90b-f8a7-45a5-89cf-5a16845d7b60" name="Mode Suitability Based on Cargo Type" triso:readOnly="false">
        <semantic:variable name="Mode Suitability Based on Cargo Type" id="_c983687b-7114-458c-ae91-4cc1a2d82118" typeRef="tModeSuitabilityBasedonCargoType"/>
        <semantic:informationRequirement id="_4e19621c-ae12-4621-b1a8-3664674bfb43" triso:readOnly="false">
            <semantic:requiredInput href="#_f8a6f0f1-7e3c-456e-b90a-dbe4883b8bea"/>
        </semantic:informationRequirement>
        <semantic:decisionTable triso:descriptionVisible="false" id="_e966f345-3348-4017-8986-6bdec4d8fe54" hitPolicy="COLLECT" outputLabel="Mode Suitability Based on Cargo Type" typeRef="tModeSuitabilityBasedonCargoType" triso:expressionId="_9f59f52e-4c54-4123-a171-a032a73eb1f5">
            <semantic:input id="_b3ef6b45-f2df-4f22-8ab7-509c46a8c05b" label="Cargo Type">
                <semantic:inputExpression typeRef="Cargo_Type">
                    <semantic:text>Cargo Type</semantic:text>
                </semantic:inputExpression>
            </semantic:input>
            <semantic:output id="_fd54ebd3-126a-4ef6-b18f-8c3b1baeb9c8" triso:allowNull="false">
                <semantic:outputValues triso:constraintsType="enumeration">
                    <semantic:text>"Road","Sea","Air","Rail","Intermodal"</semantic:text>
                </semantic:outputValues>
            </semantic:output>
            <semantic:annotation name="Description"/>
            <semantic:rule id="_2f8a3326-7b88-4400-89c5-76d6abc95d38">
                <semantic:inputEntry id="_63d9e1de-7f72-47dd-bda8-ce23f5e55cff">
                    <semantic:text>"Perishable"</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_e91c73ae-e883-40ef-84f2-ee1f7cad019c">
                    <semantic:text>"Road"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text>Road and Air are preferred due to their speed, which is critical for goods with a short shelf life. Sea and Rail are generally too slow.</semantic:text>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_74de1057-dec3-4998-b479-6df80b6b0431">
                <semantic:inputEntry id="_0df3c768-d45d-47f5-a2e8-507b7f7e04f0">
                    <semantic:text>"Perishable"</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_3e3524c8-4a46-495f-b68d-2a8cc4c7d280">
                    <semantic:text>"Air"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_41a96810-7aae-4939-a4b6-9ec296771193">
                <semantic:inputEntry id="_5d5aea06-4468-4661-86c2-5891f39ed351">
                    <semantic:text>"Perishable"</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_6e341ecf-e019-4041-b873-38928e097ea6">
                    <semantic:text>"Intermodal"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_dcc7a7d0-2160-4d0a-9ffb-8fc091103f96">
                <semantic:inputEntry id="_82d5c1d8-3be6-49b2-8b84-84ccdfd9b9b6">
                    <semantic:text>"Hazardous"</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_db2690a5-aec9-4460-83d1-63d3765b20a2">
                    <semantic:text>"Road"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text>Road, Sea, Rail, and Intermodal can all handle hazardous materials, depending on regulations and safety requirements. Air is typically excluded due to stricter safety regulations.</semantic:text>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_94f2ec58-c18f-4964-b763-ac17b31ae253">
                <semantic:inputEntry id="_2c91636f-d44e-4ee4-af01-952175b89664">
