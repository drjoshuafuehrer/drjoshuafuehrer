                </semantic:inputEntry>
                <semantic:outputEntry id="_65300b16-2e0f-414b-ac66-87fb37f66e97">
                    <semantic:text>"Road"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text>All modes are suitable, as Sea, Rail, and Intermodal become viable for longer distances, while Road and Air can still effectively serve this range.</semantic:text>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_517af111-bd49-4dd5-bcfa-6abb4bb4f26a">
