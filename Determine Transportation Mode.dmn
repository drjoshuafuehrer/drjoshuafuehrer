    <semantic:itemDefinition name="tDeliveryTimeRequirement" label="tDeliveryTimeRequirement">
        <semantic:typeRef>range&lt;number&gt;</semantic:typeRef>
        <semantic:allowedValues>
            <semantic:extensionElements>
                <triso:constraintDetails id="_03c638a0-8d65-46ed-bb8c-51a087ea97f8" constraintsType="expression">
                    <triso:value>"Delivery_Time_Requirement" &lt;= 2</triso:value>
                    <triso:display>"Delivery_Time_Requirement" &lt;= 2</triso:display>
                </triso:constraintDetails>
                <triso:constraintDetails id="_e756cedc-4966-4ce9-a8b5-05c9e0db9140" constraintsType="expression">
                    <triso:value>"Delivery_Time_Requirement" &gt;= "3 AND Delivery_Time_Requirement" &lt;= 7</triso:value>
                    <triso:display>"Delivery_Time_Requirement" &gt;= "3 AND Delivery_Time_Requirement" &lt;= 7</triso:display>
                </triso:constraintDetails>
                <triso:constraintDetails id="_12b2c75d-2962-4ed4-99cd-1706a8aa2317" constraintsType="expression">
                    <triso:value>"Delivery_Time_Requirement" &gt; 7</triso:value>
                    <triso:display>"Delivery_Time_Requirement" &gt; 7</triso:display>
                </triso:constraintDetails>
            </semantic:extensionElements>
            <semantic:text>("Delivery_Time_Requirement" &lt;= 2) and ("Delivery_Time_Requirement" &gt;= "3 AND Delivery_Time_Requirement" &lt;= 7) and ("Delivery_Time_Requirement" &gt; 7)</semantic:text>
        </semantic:allowedValues>
    </semantic:itemDefinition>
