                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text>Road and Air are preferred for short distances due to their flexibility and speed</semantic:text>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_5b114aff-af52-4266-93f4-be44313f961a">
