                    <semantic:text>Environmental Considerations</semantic:text>
                </semantic:inputExpression>
            </semantic:input>
            <semantic:output id="_db026dd6-36b1-4d16-bdb5-74c0e66c2a2a" triso:allowNull="false">
                <semantic:outputValues triso:constraintsType="enumeration">
                    <semantic:text>"Road","Sea","Air","Rail","Intermodal"</semantic:text>
                </semantic:outputValues>
            </semantic:output>
            <semantic:annotation name="Description"/>
            <semantic:rule id="_c8bce497-89d1-44b0-8887-9b88cec35a9d">
                <semantic:inputEntry id="_4f9be928-a2be-473f-9f35-3a30fd2fefc2">
                    <semantic:text>"Low Carbon Emission Priority"</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_c0dfd8be-e394-45f5-b740-336ff32e74ef">
                    <semantic:text>"Sea"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text>Sea and Rail are preferred for their lower carbon footprints. Road and Air are excluded due to higher emissions.</semantic:text>
                </semantic:annotationEntry>
            </semantic:rule>
