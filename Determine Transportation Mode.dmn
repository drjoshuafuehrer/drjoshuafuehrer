                </semantic:inputEntry>
                <semantic:outputEntry id="_da87b6cd-47b2-4286-a4c5-861584bbe1b8">
                    <semantic:text>"Sea"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_73d7e21a-921c-4973-bf88-b73cc3f9465c">
                <semantic:inputEntry id="_ce3afe06-0f07-41b7-b361-040116fc6c68">
                    <semantic:text>"Hazardous"</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_6ba93bf9-9968-49b3-88e2-c1e11272aacf">
                    <semantic:text>"Rail"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text/>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_7ff75285-7cc9-46e9-80ea-43185d05d1ac">
