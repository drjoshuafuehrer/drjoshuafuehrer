        <semantic:decisionTable triso:descriptionVisible="false" id="_544bc5f5-cd39-47a9-bfb7-0b65c6b770da" hitPolicy="COLLECT" outputLabel="Mode Suitability Based on Delivery Time Requirement" typeRef="tModeSuitabilityBasedonDeliveryTimeRequirement" triso:expressionId="_c4106e15-3acb-4790-a76a-cbf0263454cc">
            <semantic:input id="_2571c3e4-48d3-444d-a10c-c1aeb563c8da" label="Delivery Time Requirement">
                <semantic:inputExpression typeRef="Delivery_Time_Requirement">
                    <semantic:text>Delivery Time Requirement</semantic:text>
                </semantic:inputExpression>
                <semantic:inputValues triso:constraintsType="simple">
                    <semantic:text>[1..360]</semantic:text>
                </semantic:inputValues>
            </semantic:input>
            <semantic:output id="_19145ee4-d0bb-4070-9046-154b59129a31" triso:allowNull="true">
                <semantic:outputValues triso:constraintsType="enumeration">
                    <semantic:text>"Road","Sea","Air","Rail","Intermodal",null</semantic:text>
                </semantic:outputValues>
            </semantic:output>
            <semantic:annotation name="Description"/>
            <semantic:rule id="_109eee06-0814-4f10-b774-01f56dc7e444">
                <semantic:inputEntry id="_ffadb5d3-7d97-4885-bd2d-17a8914bbd5e">
                    <semantic:text>[1..2]</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_c855856b-e4cd-444e-8daa-3d1da71ad114">
                    <semantic:text>"Road"</semantic:text>
                </semantic:outputEntry>
                <semantic:annotationEntry>
                    <semantic:text>Sea and Rail are typically excluded due to longer transit times.</semantic:text>
                </semantic:annotationEntry>
            </semantic:rule>
            <semantic:rule id="_8c953bc4-8650-4f41-a89b-9d0f5c4abe43">
