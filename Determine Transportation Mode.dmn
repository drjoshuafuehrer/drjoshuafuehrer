    <semantic:decision id="_f68ba448-9b50-4c83-ae09-00e4bff244ba" name="Mode Suitability Based on Delivery Time Requirement" triso:readOnly="false">
        <semantic:variable name="Mode Suitability Based on Delivery Time Requirement" id="_e268dcf0-a98d-4cfc-8233-678e6ad1c780" typeRef="tModeSuitabilityBasedonDeliveryTimeRequirement"/>
        <semantic:informationRequirement id="_b95742cc-6d19-48c8-92b1-25b0295826be" triso:readOnly="false">
            <semantic:requiredInput href="#_ac6c661b-df6e-4418-8c34-e876a6f7570b"/>
