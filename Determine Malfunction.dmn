    <semantic:inputData id="_5a7caa5b-2fe3-4b8b-be32-92a1cb75f8f6" name="Battery Level" triso:readOnly="false">
        <semantic:description>&lt;p&gt;The current battery level of the robotic picker, measured as a percentage&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_fefef567-8ecf-4482-9e51-0cec346f90d3" modelName="Logistics Management Entity Model" itemName="Battery Level" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_aa91d13e-dc30-4fc0-afe9-f88e07e9758a" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Battery Level" id="_69157c2e-cfa0-43d4-9f48-33780c9e5152" typeRef="Battery_Level"/>
    </semantic:inputData>
    <semantic:textAnnotation id="_b7707cc0-5b1d-4db3-8454-9d3099c359b9">
        <semantic:text>Decision Node: "Is Picker Stuck?" – This node uses the business rules from Decision Table 1 to determine whether the picker is stuck based on movement, obstacle detection, error codes, and battery status.

Input Data:Picker Movement Status
Obstacle Detection
Error Code
Battery Level</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="_515e5388-a412-4f02-ae4e-903aaa13b08b">
        <semantic:text>Decision Node: "Action to Take" – This node evaluates the appropriate action based on the outcome of the first decision (Is Picker Stuck?), the priority of the task, and the manual override request.

Input Data:Task Priority
Manual Override Request</semantic:text>
    </semantic:textAnnotation>
