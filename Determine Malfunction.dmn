    <semantic:inputData id="_ee15cf64-bde7-4c7d-aa61-6e4248fea749" name="Error Code" triso:readOnly="false">
        <semantic:description>&lt;p&gt;A code generated by the robotic picker system when it encounters a malfunction or error.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_251a5c24-def6-44e0-8d93-db009fe73554" modelName="Logistics Management Entity Model" itemName="Error Code" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_cf57f2a2-23e0-4c99-a59b-b8cea4bb5bf6" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Error Code" id="_85a76249-ac78-4f19-a74a-5c95d69681e4" typeRef="Error_Code"/>
    </semantic:inputData>
    <semantic:inputData id="_fdcb73d0-e294-44d3-bb9d-a0ea2af18953" name="Manual Override Request" triso:readOnly="false">
        <semantic:description>&lt;p&gt;Indicates if a manual override has been requested by a warehouse worker to intervene in the picker&amp;rsquo;s operation.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_19c1ee43-0352-4b6a-88cd-c43e8a57a516" modelName="Logistics Management Entity Model" itemName="Manual Override Request" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_a002f185-2279-4671-97da-3b652914bb5d" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Manual Override Request" id="_6bf904ab-b183-4d1a-99d0-3d9b45824511" typeRef="boolean"/>
    </semantic:inputData>
    <semantic:inputData id="_1596ae5c-5fd1-4df3-a5c3-fd2af9d52052" name="Task Priority" triso:readOnly="false">
        <semantic:description>&lt;p&gt;The priority level assigned to the picking task.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_33019e4d-f87b-4454-979b-9f45abc9bcf5" modelName="Logistics Management Entity Model" itemName="Task Priority" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_9860b5fa-f13d-407f-87ee-c4d4184e03db" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Task Priority" id="_62eabb70-ba59-4c52-8609-6b88b33c5e70" typeRef="Task_Priority"/>
    </semantic:inputData>
    <semantic:inputData id="_f11cb936-c082-4d7d-93d1-b3941700cea9" name="Task Completion Status" triso:readOnly="false">
        <semantic:description>&lt;p&gt;Indicates whether the picker has successfully completed its assigned task.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_a57e7dc0-0fc1-494c-8be3-de1952d80630" modelName="Logistics Management Entity Model" itemName="Task Completion Status" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_448eeb14-528a-4eb8-ba4c-e8e2201be989" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Task Completion Status" id="_c70b2daf-6efa-4e6c-9334-10aee44d5122" typeRef="Task_Completion_Status"/>
    </semantic:inputData>
    <semantic:inputData id="_aa7d5aef-2586-4983-8b2b-a9c615a6771d" name="Obstacle Detection" triso:readOnly="false">
        <semantic:description>&lt;p&gt;Detects any obstacles in the robotic picker&amp;rsquo;s path that prevent it from completing its task.&lt;/p&gt;</semantic:description>
        <semantic:extensionElements>
            <triso:reuseLink id="_54369685-df2a-441e-987e-e80ce66792ae" modelName="Logistics Management Entity Model" itemName="Obstacle Detection" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_5c8a4344-95ab-44b1-9412-54ac4cf89c34" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Obstacle Detection" id="_b1b0f0c6-9b72-4e7f-bdb6-c131994e6b78" typeRef="Obstacle_Detection"/>
    </semantic:inputData>
    <semantic:inputData id="_f8e09330-2528-43de-9665-de2ff8cd49e1" name="Picker Movement Status" triso:readOnly="false">
        <semantic:extensionElements>
            <triso:reuseLink id="_ad5f6e55-7920-48e6-b679-ccd251e60371" modelName="Logistics Management Entity Model" itemName="Picker Movement Status" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_deaeb87e-281c-4a48-bcbf-5afb306290e9" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
        </semantic:extensionElements>
        <semantic:variable name="Picker Movement Status" id="_3295161f-b66f-4fb9-9e34-12f3fe39f5c8" typeRef="Picker_Movement_Status"/>
