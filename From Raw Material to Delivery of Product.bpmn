        <semantic:dataObject id="_3a5cde82-0f2f-4f2c-93d5-1d3b184dbfe8" name="Product" triso:readOnly="false" itemSubjectRef="_b3dda89b-d916-418d-ac0f-22b5ea555a64" isCollection="false">
            <semantic:documentation>&lt;p&gt;A Product is an item stored in the warehouse, ready to be sold or shipped. Each product has attributes like a unique identifier (ProductID), name, description, category, price, and weight. Products can be classified into different types such as perishable, non-perishable, or fragile.&lt;/p&gt;</semantic:documentation>
            <semantic:extensionElements>
                <triso:reuseLink id="_ae3c36c1-2298-4562-a88c-906dfdae7566" modelName="Logistics Management Entity Model" itemName="Product" modelType="http://www.trisotech.com/graph/1.0/element#BusinessEntityModel" modelURI="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67" mimeType="application/vnd.triso-businessentity+json" uri="http://www.trisotech.com/definitions/_8d80bed6-f1ed-40b5-9803-cdcc68dafa67#_266c720b-4bc8-4eb1-97ca-05a0779ada20" graphType="http://www.trisotech.com/graph/1.0/element#Term" path="Book - SCM/Logistics Management Entity Model" graphURI="http://trisotech.com/graph/1.0/graph#59f76da1-1155-478f-86b2-ab737b67b7c0"/>
            </semantic:extensionElements>
        </semantic:dataObject>
        <semantic:exclusiveGateway id="_dd768d62-80d6-40df-8ff6-1c8576b1768f" name="Movement&#10;type?" triso:readOnly="false" gatewayDirection="Diverging">
