    <bpmndi:BPMNDiagram id="_620da0bc-bfaa-413f-a653-bf5ce2ccadf0" name="Forecast Demand" documentation="&lt;p&gt;&lt;strong&gt;Demand planning&lt;/strong&gt;&amp;nbsp;is the process of forecasting future customer demand to optimize inventory management. It's a strategic approach that allows warehouse managers and demand planners to anticipate sales trends, plan for seasonal fluctuations, and ensure that the right products are available at the right time&lt;/p&gt;">
        <bpmndi:BPMNPlane bpmnElement="_a7be1424-e67a-4d8a-9ede-2b113e92b311" id="_620da0bc-bfaa-413f-a653-bf5ce2ccadf0_plane" trisobpmn:diagramWidth="1485" trisobpmn:diagramHeight="1050"/>
